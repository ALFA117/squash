# Copy to .env.local and fill in what you need.
#
# NONE OF THIS IS REQUIRED TO RUN THE APP. With an empty file the engine
# answers for free, the plan still computes, and every screen works. Fill it
# in when you want to exercise the paid path.
#
# .env.local is gitignored. Never commit it, never paste these values into a
# chat, and never reuse a key from a wallet that holds real funds. Everything
# here is TESTNET — free, and worth nothing.

# ── The engine: the account that GETS PAID ────────────────────────────────
#
# Free testnet account, no card, no personal data:
#   https://portal.hedera.com/  →  Testnet  →  create account
#
# The portal shows the same key several ways. Copy the DER Encoded Private
# Key if it offers one; if you only get raw hex, set the type below to match
# the account you created — a hex key parses as EITHER curve and only one is
# right, which fails in a way that tells you nothing.

HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_KEY_TYPE=ECDSA          # ECDSA | ED25519 — required for raw hex keys
HEDERA_OPERATOR_KEY=

# HCS topic that each netting run's proof is published to.
# Create once:  node scripts/create-topic.mjs
HEDERA_HCS_TOPIC_ID=

# ── The agent: the account that PAYS ──────────────────────────────────────
#
# Must be a DIFFERENT account from the engine. An agent paying its own
# account is a transfer that nets to nothing and the facilitator rejects it.
# Create and fund one from the operator's balance:
#   node scripts/create-agent.mjs

AGENT_ACCOUNT_ID=
AGENT_KEY_TYPE=ECDSA
AGENT_KEY=

# ── The x402 facilitator ──────────────────────────────────────────────────
#
# Testnet is open access and needs no API key. It also SPONSORS THE NETWORK
# FEE, which is why a caller can pay for the service without holding HBAR.

X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Turn the gate on. Off = the engine answers without charging, which is what
# you want while building UI. On = an unpaid call gets a 402.
X402_ENABLED=false
