# Copy to .env.local and fill in. .env.local is gitignored — never commit it,
# never paste these values into a chat, and never use a seed phrase from a
# wallet that holds real funds. Create a fresh TESTNET account for this.
#
# Get a free testnet account + 1,000 test HBAR (no card, no personal data):
#   https://portal.hedera.com/  → Testnet → create account
# Or fund an address anonymously (100 HBAR / 24h):
#   https://docs.hedera.com/evm/quickstart/get-test-hbar

HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=

# HCS topic the engine publishes each run's proof to. Created on first run
# if left blank; paste the id back here to reuse it.
HEDERA_HCS_TOPIC_ID=

# x402 facilitator. Testnet is open access and needs no API key.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Turn on once the payment path is wired (day 2). Off = the engine answers
# without charging, so the UI keeps working while the rail is being built.
X402_ENABLED=false
